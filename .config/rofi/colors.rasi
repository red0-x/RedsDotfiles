/* Everforest Liquid Glass — waybar colourway for the secondary rofi modi
 * (cliphist, screenshot, themes, hyprshade, short, compact).
 * Same values as waybar/themes/ml4w/everforest + rice-palette.css.
 * Regenerated palette lives in rice-palette.rasi; this file maps the
 * matugen-style names those configs expect onto the same colours. */
* {
    background: #2d353bbc;
    primary: #a7c080;
    primary-fixed: #c2dba0;
    primary-fixed-dim: #a7c080;
    on-primary: #2d353b;
    on-primary-fixed: #232a2e;
    on-primary-fixed-variant: #343f44;
    primary-container: #343f44;
    on-primary-container: #c2dba0;

    secondary: #9da9a0;
    secondary-fixed: #c5c0a8;
    secondary-fixed-dim: #859289;
    on-secondary: #232a2e;
    on-secondary-fixed: #232a2e;
    on-secondary-fixed-variant: #3d484d;
    secondary-container: #3d484d;
    on-secondary-container: #e6dcc2;

    tertiary: #7fbbb3;
    tertiary-fixed: #a8d5cf;
    tertiary-fixed-dim: #7fbbb3;
    on-tertiary: #232a2e;
    on-tertiary-fixed: #232a2e;
    on-tertiary-fixed-variant: #3d484d;
    tertiary-container: #3d484d;
    on-tertiary-container: #a8d5cf;

    error: #e67e80;
    on-error: #2d353b;
    error-container: #4b5a5f;
    on-error-container: #ee9ea0;

    surface: #2d353b;
    on-surface: #e6dcc2;
    on-surface-variant: #c5c0a8;
    outline: #859289;
    outline-variant: #475258;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e6dcc2;
    inverse-on-surface: #2d353b;
    inverse-primary: #c2dba0;

    surface-dim: #232a2e;
    surface-bright: #475258;
    surface-container-lowest: #232a2e;
    surface-container-low: #2d353b;
    surface-container: #343f44;
    surface-container-high: #3d484d;
    surface-container-highest: #475258;
}
