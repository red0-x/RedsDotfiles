/* Everforest Liquid Glass — matches waybar. Colors from wallcolors.py.
 * Previous: config.rasi.bak-glass */
configuration {
    modi:                 "drun,filebrowser,window,run";
    show-icons:           true;
    display-drun:         "";
    display-run:          "";
    display-filebrowser:  "";
    display-window:       "";
    drun-display-format:  "{name}";
    hover-select:         true;
    scroll-method:        1;
    me-select-entry:      "";
    me-accept-entry:      "MousePrimary";
    window-format:        "{w} · {c} · {t}";
    font:                 "Fira Sans Semibold 11";
}

@import "rice-palette.rasi"
@import "~/.cache/ml4w/hyprland-dotfiles/current_wallpaper.rasi"

* {
    background-color: transparent;
    foreground:                  @ef-fg-bright;
    normal-foreground:           @ef-fg;
    alternate-normal-foreground: @ef-fg;
    selected-normal-foreground:  @ef-bg0;
    selected-normal-background:  @sel;
    text-color:   @ef-fg-bright;
    border-color: @edge;
}

window {
    width:            34em;
    background-image: @current-image;
    border:           1px;
    border-color:     @edge;
    border-radius:    16px;
    padding:          0;
}

mainbox {
    background-color: @glass;
    border-radius:    15px;
    padding:          14px;
    spacing:          12px;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @glass-chip;
    border:           1px;
    border-color:     @edge;
    border-radius:    12px;
    padding:          9px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}
prompt { text-color: @ef-l-green; font: "Font Awesome 6 Free Solid 12"; vertical-align: 0.5; }
entry  { placeholder: "Search…"; placeholder-color: @ef-grey1; text-color: @ef-fg-bright; cursor: text; vertical-align: 0.5; }

listview {
    lines:     8;
    columns:   1;
    spacing:   2px;
    scrollbar: false;
    border:    0;
    fixed-height: true;
}

element {
    padding:       5px 10px;
    spacing:       10px;
    border-radius: 9px;
    cursor:        pointer;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @ef-fg; }
element normal.active, element alternate.active { text-color: @ef-l-green; }
element normal.urgent, element alternate.urgent { text-color: @ef-l-red; }
element selected.normal, element selected.active {
    background-color: @sel;
    text-color:       @ef-bg0;
}
element selected.urgent { background-color: @ef-red; text-color: @ef-bg0; }

element-icon { size: 1.3em; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; highlight: bold #e6dcc2; }
element selected element-text { highlight: bold; }

message  { background-color: @glass-chip; border-radius: 10px; padding: 8px 12px; }
textbox  { text-color: @ef-fg; }
