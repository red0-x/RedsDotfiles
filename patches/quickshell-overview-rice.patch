diff --git a/modules/overview/Overview.qml b/modules/overview/Overview.qml
index 57c9187..a528f4c 100644
--- a/modules/overview/Overview.qml
+++ b/modules/overview/Overview.qml
@@ -323,11 +323,22 @@ Scope {
         const group = Math.floor((baseId - workspaceOffset - 1) / workspacesPerGroup);
         const minWorkspaceId = group * workspacesPerGroup + 1 + workspaceOffset;
         const maxWorkspaceId = minWorkspaceId + workspacesPerGroup - 1;
-        let next = baseId + direction;
-        if (next > maxWorkspaceId)
-            next = minWorkspaceId;
-        else if (next < minWorkspaceId)
-            next = maxWorkspaceId;
+        // Only stop on workspaces that actually have windows (plus the active one);
+        // tabs should walk real windows, not empty grid cells.
+        const occupied = new Set(Hyprland.toplevels.values
+            .map(t => t.workspace?.id ?? -1)
+            .filter(id => id >= 1));
+        occupied.add(Hyprland.focusedMonitor?.activeWorkspace?.id ?? 1);
+        let next = baseId;
+        for (let i = 0; i < workspacesPerGroup; i++) {
+            next += direction;
+            if (next > maxWorkspaceId)
+                next = minWorkspaceId;
+            else if (next < minWorkspaceId)
+                next = maxWorkspaceId;
+            if (occupied.has(next))
+                break;
+        }
         GlobalStates.overviewSelectedWorkspaceId = next;
     }
 
