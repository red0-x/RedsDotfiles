+/// Float transient chrome in a palette-painted pill without reserving another
+/// row. The content contracts to the terminal width before the caps go on.
+fn chrome_island_line(
+    line: Line<'static>,
+    width: u16,
+    bg: Color,
+) -> Line<'static> {
+    if line.width() == 0 {
+        return line;
+    }
+    if width < 6 {
+        return Line::from(overscroll_truncate_spans(line.spans, usize::from(width)))
+            .alignment(Alignment::Center);
+    }
+    let spans = overscroll_truncate_spans(line.spans, usize::from(width - 4));
+    Line::from(overscroll_pill_spans(&[StatusPill { bg, spans }]))
+        .alignment(Alignment::Center)
+}
