+#[test]
+fn processing_status_island_is_centered_and_rice_painted() {
+    let _guard = viewport_snapshot_test_lock();
+    let mut state = static_chrome_state(None);
+    state.status = ProcessingStatus::Sending;
+    state.centered_mode = false;
+    let backend = ratatui::backend::TestBackend::new(80, 1);
+    let mut terminal = ratatui::Terminal::new(backend).unwrap();
+
+    terminal
+        .draw(|frame| crate::tui::ui::input_ui::draw_status(frame, &state, frame.area(), 0))
+        .unwrap();
+
+    let buffer = terminal.backend().buffer();
+    let text = buffer
+        .content
+        .iter()
+        .map(|cell| cell.symbol())
+        .collect::<String>();
+    assert!(text.contains("sending"), "{text}");
+    assert!(text.contains('\u{e0b6}'), "missing left cap: {text}");
+    assert!(text.contains('\u{e0b4}'), "missing right cap: {text}");
+    let first_ink = buffer
+        .content
+        .iter()
+        .position(|cell| cell.symbol() != " ")
+        .unwrap();
+    assert!(first_ink > 0, "island should float in from the left: {text}");
+    let bg = crate::tui::wallpaper::wallpaper().surface_container;
+    assert!(
+        buffer
+            .content
+            .iter()
+            .any(|cell| cell.symbol() == "s" && cell.bg == bg),
+        "status text should sit on the wallpaper surface: {text}"
+    );
+}
+
+#[test]
+fn notification_status_island_uses_the_same_rice_chrome() {
+    let _guard = viewport_snapshot_test_lock();
+    let state = static_chrome_state(Some("Worker finished"));
+    let backend = ratatui::backend::TestBackend::new(60, 1);
+    let mut terminal = ratatui::Terminal::new(backend).unwrap();
+
+    terminal
+        .draw(|frame| {
+            crate::tui::ui::input_ui::draw_notification(frame, &state, frame.area())
+        })
+        .unwrap();
+
+    let buffer = terminal.backend().buffer();
+    let text = buffer
+        .content
+        .iter()
+        .map(|cell| cell.symbol())
+        .collect::<String>();
+    assert!(text.contains("Worker finished"), "{text}");
+    assert!(text.contains('\u{e0b6}'), "missing left cap: {text}");
+    assert!(text.contains('\u{e0b4}'), "missing right cap: {text}");
+    let bg = crate::tui::wallpaper::wallpaper().secondary_container;
+    assert!(
+        buffer
+            .content
+            .iter()
+            .any(|cell| cell.symbol() == "W" && cell.bg == bg),
+        "notification should use the secondary rice surface: {text}"
+    );
+}
